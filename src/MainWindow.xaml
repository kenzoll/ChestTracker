<Window x:Class="ChestTracker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ChestTracker" Title="Chest Tracker" Width="1200" Height="880"
        MinWidth="940" MinHeight="700" Background="#080808" Foreground="White" FontFamily="Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen" Loaded="WindowLoaded" Closing="WindowClosing">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#B5B5B5"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#181818"/>
      <Setter Property="BorderBrush" Value="#393939"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="17,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.55"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#CB2939"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#CB2939"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#B5B5B5"/><Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style x:Key="DarkListItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="8,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Selection" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="7">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#242124"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Background" Value="#441720"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RouteCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="11,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Surface" Background="#1A1A1A" BorderBrush="#393939" BorderThickness="1" CornerRadius="7">
                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#CFCFCF" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#282328"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="11,8,26,8" IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
            <Border Background="#191719" BorderBrush="#493337" BorderThickness="1" CornerRadius="7" Padding="3"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="275" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8,6"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#441720"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#441720"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#101010"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="RowBackground" Value="#101010"/>
      <Setter Property="AlternatingRowBackground" Value="#141414"/><Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="RowHeaderWidth" Value="0"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/><Setter Property="RowHeight" Value="43"/>
      <Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#101010"/><Setter Property="Foreground" Value="#B5B5B5"/>
      <Setter Property="Padding" Value="12,12"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#292929"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#333333"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="#111111"/><Setter Property="BorderBrush" Value="#292929"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="24"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#181818"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#414141"/><Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#55555D" CornerRadius="4" Margin="2,0"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#A4A4AD"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#DDDDE1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb x:Name="ScrollGrip" Style="{StaticResource ScrollThumb}" MinHeight="32"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="ScrollGrip" Property="MinHeight" Value="0"/><Setter TargetName="ScrollGrip" Property="MinWidth" Value="32"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers></Style>
    <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border x:Name="Rail" Width="48" Height="28" Background="#34343B" CornerRadius="14"><Ellipse x:Name="Knob" Width="20" Height="20" Fill="#DDDDE2" HorizontalAlignment="Left" Margin="4,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="#EEEEF2"/><Setter TargetName="Knob" Property="Fill" Value="#151518"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="RewardCheck" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Background="Transparent" Width="20" Height="20" CornerRadius="6" BorderBrush="#686872" BorderThickness="1" Margin="0,0,10,0"></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="White"/><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Margin="32,24,32,16" x:Name="RootContent">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,25">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="{x:Static local:Brand.Logo}" Width="44" Height="44" Margin="0,0,14,0"/>
        <StackPanel><TextBlock Text="CHEST TRACKER" FontSize="23" FontWeight="Bold"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <TextBlock Text="6.1" HorizontalAlignment="Right" FontSize="13" Foreground="#FF6675"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="CounterNav" Content="Счетчик" Style="{StaticResource Nav}" Click="ShowCounter"/>
        <Button x:Name="RoutesNav" Content="Маршруты" Style="{StaticResource Nav}" Click="ShowRoutes"/>
        <Button x:Name="MapNav" Content="Карта сундуков" Style="{StaticResource Nav}" Click="ShowMap"/>
        <Button x:Name="RewardsNav" Content="Награды" Style="{StaticResource Nav}" Click="ShowRewards"/>
        <Button x:Name="HistoryNav" Content="История матчей" Style="{StaticResource Nav}" Click="ShowHistory"/>
        <Button x:Name="HealthNav" Content="Настройки" Style="{StaticResource Nav}" Click="ShowHealth"/>
      </StackPanel>
      <TextBlock x:Name="PlayerLabel" Grid.Column="1" Text="Игрок определится автоматически" Foreground="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12" MaxWidth="170" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="0,0,4,0">
        <StackPanel x:Name="CounterPage">
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16" Padding="20,18">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Ellipse x:Name="PulseDot" Width="9" Height="9" Fill="White" VerticalAlignment="Top" Margin="0,7,15,0"/>
              <StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock x:Name="StatusText" Text="Проверяю повторы Fortnite…" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="StatusDetail" Text="Запуск наблюдения" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                <ProgressBar x:Name="AnalysisProgress" Height="2" Margin="0,12,0,0" IsIndeterminate="True" Background="#333333" Foreground="White" Visibility="Collapsed"/>
              </StackPanel>
              <Button x:Name="ObserveButton" Grid.Column="2" Content="Пауза" Style="{StaticResource Primary}" MinWidth="120" VerticalAlignment="Center" Click="ToggleObservation"/>
            </Grid>
          </Border>
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
              <StackPanel><TextBlock Text="ВСЕГО СУНДУКОВ" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="TotalNumber" Text="0" FontSize="78" FontWeight="SemiBold" Margin="-4,0,0,0"/>
                <TextBlock x:Name="TotalCaption" Text="Начальная сумма + сохранённые матчи" Foreground="{StaticResource Muted}" FontSize="12"/>
                <Button x:Name="ChestEntryButton" Click="ChangeBaseline" HorizontalAlignment="Left" Padding="0,9" Margin="0,13,0,0" Background="Transparent" BorderThickness="0" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
              <StackPanel><TextBlock Text="ПОСЛЕДНИЙ МАТЧ" Foreground="{StaticResource Muted}" FontSize="11"/>
                <TextBlock x:Name="LastNumber" Text="—" FontSize="61" FontWeight="SemiBold" Margin="0,5,0,4"/>
                <TextBlock x:Name="LastCaption" Text="Появится после завершения матча" Foreground="{StaticResource Muted}" FontSize="12"/>
                <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock x:Name="LastNormal" Text="—" FontSize="18"/><TextBlock Text="Обычные" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock x:Name="LastRare" Text="—" FontSize="18"/><TextBlock Text="Редкие" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>
          <Grid Margin="2,6,2,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Последние матчи" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Вся история →" Style="{StaticResource Nav}" Padding="6,2" Click="ShowHistory"/>
          </Grid>
          <Border Background="#101010" BorderBrush="#292929" BorderThickness="1" CornerRadius="12" Padding="5">
            <Grid><DataGrid x:Name="RecentGrid" MinHeight="110" MaxHeight="236" MouseDoubleClick="ShowRecentDetails">
              <DataGrid.Columns><DataGridTextColumn Header="Дата и время" Binding="{Binding DateLabel}" Width="2*"/>
                <DataGridTextColumn Header="Обычные" Binding="{Binding Normal}" Width="*"/><DataGridTextColumn Header="Редкие" Binding="{Binding Rare}" Width="*"/><DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="*"/>
              </DataGrid.Columns></DataGrid>
              <TextBlock x:Name="EmptyRecent" Text="Завершите первый матч — он появится здесь автоматически." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" IsHitTestVisible="False" Margin="16"/>
            </Grid>
          </Border>
        </StackPanel>
        <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
          <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="История матчей" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="HistoryCaption" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="12">
              <StackPanel>
                <TextBlock Text="По дням" FontWeight="SemiBold" Margin="5,2,0,8"/>
                <ListBox x:Name="HistoryDayList" MaxHeight="335" Background="#111111" BorderThickness="0" Foreground="White"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="SelectHistoryDay"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="12">
              <StackPanel>
                <TextBlock x:Name="HistoryDaySummary" FontSize="16" FontWeight="SemiBold" Margin="5,2,0,10"/>
                <DataGrid x:Name="HistoryGrid" Height="280" MouseDoubleClick="ShowHistoryDetails" SelectionChanged="SelectHistoryMatch">
              <DataGrid.Columns><DataGridTextColumn Header="Дата и время" Binding="{Binding DateLabel}" Width="2*"/>
                <DataGridTextColumn Header="Обычные" Binding="{Binding Normal}" Width="*"/><DataGridTextColumn Header="Редкие" Binding="{Binding Rare}" Width="*"/><DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="*"/>
              </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </Grid>
          <WrapPanel Margin="0,16,0,4"><Button x:Name="MatchDetailsButton" Content="Подробности матча" Click="HistoryDetails" Margin="0,0,10,8"/>
            <Button x:Name="RecountButton" Content="Пересчитать матч" Click="RecountSelectedMatch" Margin="0,0,10,8"/>
            <Button x:Name="DeleteMatchButton" Content="Удалить запись" Click="DeleteSelectedMatch" Margin="0,0,10,8"/>
          </WrapPanel>
          <TextBlock x:Name="RecountFeedback" Foreground="{StaticResource Muted}" Margin="2,0,0,8" AutomationProperties.LiveSetting="Polite"/>
          <Border Style="{StaticResource Panel}" Margin="0,20,0,0"><StackPanel><TextBlock Text="Последние 10 матчей" FontSize="15"/>
            <Canvas x:Name="ActivityChart" Height="100" Margin="0,18,0,0" SizeChanged="ChartSizeChanged"/>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="RewardsPage" Visibility="Collapsed">
          <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Сокровища сезона" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Treasure Hunters · награды из сундуков по неделям" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Актуальный список ↗" Click="OpenRewardSource" VerticalAlignment="Center"/>
          </Grid>
          <WrapPanel x:Name="WeekTabs" Margin="0,0,0,20"/>
          <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="WeekHeading" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="WeekDates" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
            <TextBlock x:Name="WeekStatus" Grid.Column="1" Foreground="#FF7280" VerticalAlignment="Center" FontSize="12"/>
          </Grid>
          <TextBlock x:Name="RewardOddsNote" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14"/>
          <WrapPanel x:Name="RewardCards"/>
          <Border x:Name="UnknownRewardsPanel" Style="{StaticResource Panel}" Visibility="Collapsed" MinHeight="200" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center"><TextBlock Text="Сокровища пока не раскрыты" FontSize="24" FontWeight="SemiBold"/>
              <TextBlock Text="В проверенном источнике ещё нет состава этой недели. Здесь не показаны выдуманные или неподтверждённые награды. Проверьте актуальный список Fortnite.gg." Foreground="{StaticResource Muted}" Margin="0,13,0,0" MaxWidth="700" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="RewardProgress" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,8"/>
        </StackPanel>
        <StackPanel x:Name="MapPage" Visibility="Collapsed">
          <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Карта сундуков" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Crossbones Isle" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Fortnite.gg ↗" Click="OpenMapSource" VerticalAlignment="Center"/>
          </Grid>
          <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <WrapPanel x:Name="MapLayerChoices" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="−" Padding="14,7" Click="MapZoomOut" Margin="0,0,6,0"/><Button Content="+" Padding="14,7" Click="MapZoomIn" Margin="0,0,6,0"/><Button Content="Вся карта" Padding="14,7" Click="MapFit"/></StackPanel>
          </Grid>
          <Border CornerRadius="15" BorderBrush="#3E3033" BorderThickness="1" Background="#101014" ClipToBounds="True">
            <local:ChestMap x:Name="MapViewer" Height="520"/>
          </Border>
        </StackPanel>
        <StackPanel x:Name="RoutesPage" Visibility="Collapsed">
          <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Маршруты" FontSize="31" FontWeight="SemiBold"/>
              <TextBlock Text="Остров черепа и костей · маршруты для сбора сундуков" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Fortnite.gg ↗" Click="OpenMapSource" VerticalAlignment="Center"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="308"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Построить свой маршрут" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock Text="Откуда начать" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5"/>
                  <ComboBox x:Name="RouteStartChoice" Style="{StaticResource RouteCombo}" Margin="0,0,0,10" AutomationProperties.Name="Откуда начать">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="Цель по сундукам" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5"/>
                  <ComboBox x:Name="RouteLengthChoice" Style="{StaticResource RouteCombo}" Margin="0,0,0,10" AutomationProperties.Name="Цель по сундукам">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox x:Name="AvoidRouteWater" Content="Меньше переправ" IsChecked="True" Foreground="White" Margin="0,0,0,12"/>
                  <Button Content="Построить маршрут" Style="{StaticResource Primary}" Click="GenerateRoute"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Panel}" Padding="12">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="ReadyRoutesButton" Content="Готовые" Padding="8,7" Click="ShowReadyRoutes"/>
                    <Button x:Name="SavedRoutesButton" Grid.Column="2" Content="Мои маршруты" Padding="8,7" Click="ShowSavedRoutes"/>
                  </Grid>
                  <ListBox x:Name="RouteGuideList" Background="#111111" Foreground="White" BorderThickness="0" MaxHeight="280"
                           DisplayMemberPath="Name" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="SelectRouteGuide"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  <ListBox x:Name="SavedRouteList" Visibility="Collapsed" Background="#111111" Foreground="White" BorderThickness="0" MaxHeight="280"
                           DisplayMemberPath="Name" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="SelectSavedRoute"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                  <TextBlock x:Name="NoSavedRoutes" Visibility="Collapsed" Text="Сохранённые маршруты появятся здесь." Foreground="{StaticResource Muted}" Margin="5,8"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="RouteHeading" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RouteTotal" Grid.Column="1" Foreground="#FF8996" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="RouteOverview" Foreground="{StaticResource Muted}" Margin="0,7,0,9"/>
                  <WrapPanel x:Name="RouteLegend"/>
                  <TextBlock Text="Подсчёт по карте. Часть сундуков может не появиться в матче." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                  <WrapPanel x:Name="RouteActions" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button x:Name="SaveRouteButton" Content="Сохранить маршрут" Padding="10,6" Margin="0,0,8,0" Click="SaveCurrentRoute"/>
                    <Button x:Name="RenameRouteButton" Content="Переименовать" Padding="10,6" Margin="0,0,8,0" Click="RenameSavedRoute"/>
                    <Button x:Name="DeleteRouteButton" Content="Удалить" Padding="10,6" Click="DeleteSavedRoute"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border BorderBrush="#403034" BorderThickness="1" CornerRadius="13" ClipToBounds="True">
                <Grid>
                  <local:ChestMap x:Name="RouteMap" Height="354" SizeChanged="RouteMapSized"/>
                  <Button Content="Весь маршрут" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="11,7" Click="FitRouteMap"/>
                </Grid>
              </Border>
              <TextBlock Text="Красные стрелки ведут между районами. Нажмите на номер, чтобы увидеть обход сундуков внутри района." FontSize="12" Foreground="{StaticResource Muted}" Margin="2,9,0,12"/>
              <Border Style="{StaticResource Panel}" Padding="14">
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Порядок обхода" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                  </Grid>
                  <ListBox x:Name="RouteStopList" MaxHeight="226" Background="#111111" BorderThickness="0" Foreground="White"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource DarkListItem}" SelectionChanged="SelectRouteStop">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding Heading}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Instruction}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="HealthPage" Visibility="Collapsed">
          <TextBlock Text="Настройки" FontSize="31" FontWeight="SemiBold" Margin="0,0,0,24"/>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,24,0"><TextBlock Text="Напоминание о духе" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Через 15 секунд после записи матча." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
              <CheckBox x:Name="ReminderToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="ReminderSettingChanged" Unchecked="ReminderSettingChanged"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,24,0"><TextBlock Text="Анимации" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Плавные переходы и отклик кнопок. При сворачивании приостанавливаются." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0"/></StackPanel>
              <CheckBox x:Name="AnimationToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="AnimationSettingChanged" Unchecked="AnimationSettingChanged"/>
            </Grid>
          </Border>
          <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
            <TextBlock Text="Запись матчей" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="HealthSummary" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,0"/>
            <TextBlock Text="В Fortnite включите: Настройки → Игра → Повторы → Записывать повторы." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
            <StackPanel x:Name="ProfilePanel" Visibility="Collapsed" Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="Игрок" VerticalAlignment="Center" Margin="0,0,15,0"/><ComboBox x:Name="ProfileCombo" Width="260" Padding="8" SelectionChanged="ChangeProfile" DisplayMemberPath="Name"/></StackPanel>
          </StackPanel></Border>
          <Border x:Name="UpdatePanel" Style="{StaticResource Panel}" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Обновления приложения" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="UpdateStatus" Text="Новые версии загружаются автоматически и устанавливаются при закрытии приложения." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
              <Button x:Name="UpdateCheckButton" Grid.Column="1" Content="Проверить" Click="CheckUpdates" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Expander Header="Дополнительно" Foreground="{StaticResource Muted}" Padding="5" Margin="0,8,0,0">
            <WrapPanel Margin="0,16,0,0"><Button Content="Выбрать папку повторов" Click="ChangeReplayFolder" Margin="0,0,12,10"/><Button Content="О приложении" Click="ShowAbout" Margin="0,0,12,10"/></WrapPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <Border x:Name="UpdateNotice" Grid.RowSpan="4" Panel.ZIndex="50" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="510"
            Background="#171216" BorderBrush="#A53246" BorderThickness="1" CornerRadius="16" Padding="23" Margin="16">
      <StackPanel>
        <TextBlock Text="Обновление готово" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="Новая версия уже скачана. Приложение обновится и запустится снова, история и настройки сохранятся." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,10,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="DismissUpdateButton" Content="Закрыть" Click="DismissUpdate" Margin="0,0,10,0" ToolTip="Отложить до закрытия приложения"/>
          <Button Content="Обновить" Click="InstallUpdateNow" Style="{StaticResource Primary}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
